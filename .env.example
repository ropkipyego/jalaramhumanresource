# Jalaram HR — Docker self-host

POSTGRES_DB=jalaramhr
POSTGRES_USER=jalaramhr
POSTGRES_PASSWORD=change-me-strong-password

# Host ports (change when co-hosting with Afya-Sasa on same server)
NGINX_HOST_PORT=8080
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

JWT_ACCESS_SECRET=replace-with-long-random-secret-min-32-chars

MINIO_ROOT_USER=jalaramhr
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=employee-documents

FRONTEND_ORIGIN=http://localhost:8080
DEFAULT_TENANT_CODE=jalaram

VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=http://localhost:8080
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
VITE_USE_API_AUTH=true

# Super admin (platform) vs staff domain
SUPER_ADMIN_EMAIL=admin@humasync.solutions
VITE_SUPER_ADMIN_EMAIL=admin@humasync.solutions
SUPER_ADMIN_PASSWORD=LocalAdmin2026!
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_STAFF_ID=SA-001
STAFF_EMAIL_DOMAIN=jalaram.co.ke
VITE_STAFF_EMAIL_DOMAIN=jalaram.co.ke

