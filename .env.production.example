# Jalaram HR — Humasync Contabo production
# VPS: 102.68.79.109  |  Domain: hr.humasync.solutions
#
# Setup:
#   cp .env.production.example .env
#   # Generate 3 secrets: openssl rand -base64 48
#   nano .env
#   bash scripts/deploy-contabo.sh

NODE_ENV=production
PORT=3000

PUBLIC_URL=https://hr.humasync.solutions
FRONTEND_ORIGIN=https://hr.humasync.solutions

# Co-host with Afya-Sasa EMR on same VPS (EMR :8080, HR :8081)
NGINX_HOST_PORT=8081

# Staff invite / bulk upload — hospital staff use @jalaram.co.ke
STAFF_EMAIL_DOMAIN=jalaram.co.ke
VITE_STAFF_EMAIL_DOMAIN=jalaram.co.ke

# Platform super admin (separate domain — not used for staff invite)
SUPER_ADMIN_EMAIL=admin@humasync.solutions
VITE_SUPER_ADMIN_EMAIL=admin@humasync.solutions

POSTGRES_DB=jalaramhr
POSTGRES_USER=jalaramhr
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand

JWT_ACCESS_SECRET=CHANGE_ME_use_openssl_rand_min_32_chars

MINIO_ROOT_USER=jalaramhr
MINIO_ROOT_PASSWORD=CHANGE_ME_use_openssl_rand
S3_BUCKET=employee-documents

DEFAULT_TENANT_CODE=jalaram

VITE_API_BASE_URL=/api/v1
VITE_SUPABASE_URL=https://hr.humasync.solutions
VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
VITE_USE_API_AUTH=true

SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_STAFF_ID=SA-001
