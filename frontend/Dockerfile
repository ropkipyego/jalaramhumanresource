FROM node:22-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM deps AS build
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_SUPABASE_URL=http://localhost:8080
ARG VITE_SUPABASE_PUBLISHABLE_KEY=local-anon-key
ARG VITE_USE_API_AUTH=true
ARG VITE_DEFAULT_TENANT=jalaram
ARG VITE_STAFF_EMAIL_DOMAIN=jalaram.co.ke
ARG VITE_SUPER_ADMIN_EMAIL=admin@humasync.solutions
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY
ENV VITE_USE_API_AUTH=$VITE_USE_API_AUTH
ENV VITE_DEFAULT_TENANT=$VITE_DEFAULT_TENANT
ENV VITE_STAFF_EMAIL_DOMAIN=$VITE_STAFF_EMAIL_DOMAIN
ENV VITE_SUPER_ADMIN_EMAIL=$VITE_SUPER_ADMIN_EMAIL
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
